# Versioned catalog produced by app.data.ingest (required for real data)
BRICKMATCH_CATALOG=data/processed/VERSION/catalog.json
BRICKMATCH_DB=data/brickmatch.db

# Static interface and measured evaluation report
BRICKMATCH_UI_DIR=frontend/web
BRICKMATCH_EVALUATION=data/evaluation_results.json

# Comma-separated origins for a separately hosted dev frontend.
# Same-origin serving needs no CORS entry.
BRICKMATCH_CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# Optional verified artifacts. Without them the API reports the metadata/catalog fallback.
# BRICKMATCH_EMBEDDINGS=artifacts/embeddings/clip.npz
# BRICKMATCH_CLASSIFIER_DIR=artifacts/models

# Legacy Streamlit only; the product interface is served by FastAPI at http://127.0.0.1:8000/
# BRICKMATCH_API_URL=http://127.0.0.1:8000/api/v1
